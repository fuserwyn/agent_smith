# Copy to .env and fill in. Never commit .env. Several keys per provider are rotated automatically.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
# or comma separated:
# OPENROUTER_API_KEYS=key1,key2
GROQ_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
# Generic fallback used when --provider-url matches no known provider:
LLM_API_KEY=
# Self-hosted (no key): ollama serve, then --provider-url http://localhost:11434/v1 --model-name qwen2.5-coder:7b
