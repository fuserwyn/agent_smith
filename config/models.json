{
  "providers": [
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_API_KEY",
      "hosts": [
        "openrouter.ai"
      ],
      "extra_body": {
        "reasoning": {
          "enabled": false
        }
      }
    },
    {
      "name": "groq",
      "base_url": "https://api.groq.com/openai/v1",
      "key_env": "GROQ_API_KEY",
      "hosts": [
        "groq.com"
      ],
      "extra_body": {
        "reasoning_effort": "low"
      },
      "limits": "Groq free tier: ~30 requests/min, ~1000/day and a tokens/min cap per model"
    },
    {
      "name": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "key_env": "GEMINI_API_KEY",
      "hosts": [
        "generativelanguage.googleapis.com"
      ],
      "extra_body": {
        "reasoning_effort": "none"
      },
      "limits": "Google AI Studio free tier: requests/min and requests/day caps per model"
    },
    {
      "name": "mistral",
      "base_url": "https://api.mistral.ai/v1",
      "key_env": "MISTRAL_API_KEY",
      "hosts": [
        "mistral.ai"
      ]
    },
    {
      "name": "together",
      "base_url": "https://api.together.xyz/v1",
      "key_env": "TOGETHER_API_KEY",
      "hosts": [
        "together.xyz",
        "together.ai"
      ]
    },
    {
      "name": "cerebras",
      "base_url": "https://api.cerebras.ai/v1",
      "key_env": "CEREBRAS_API_KEY",
      "hosts": [
        "cerebras.ai"
      ]
    },
    {
      "name": "nvidia",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "key_env": "NVIDIA_API_KEY",
      "hosts": [
        "nvidia.com"
      ],
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        },
        "reasoning_effort": "none"
      },
      "limits": "build.nvidia.com free credits: ~40 requests/min"
    },
    {
      "name": "ollama",
      "base_url": "http://localhost:11434/v1",
      "key_env": null,
      "hosts": [
        "localhost",
        "127.0.0.1"
      ]
    },
    {
      "name": "cohere",
      "base_url": "https://api.cohere.ai/compatibility/v1",
      "key_env": "COHERE_API_KEY",
      "hosts": [
        "cohere.ai",
        "cohere.com"
      ],
      "extra_body": {
        "reasoning_effort": "none"
      },
      "limits": "trial key: 20 calls/min, 1000 calls/month"
    }
  ],
  "models": [
    {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "notes": "free (build.nvidia.com), reasoning off"
    },
    {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "notes": "free (build.nvidia.com), fast"
    },
    {
      "provider": "openrouter",
      "model": "nvidia/nemotron-3.5-lightning:free",
      "notes": "free on OpenRouter (:free models: 50 requests/day without credits): the NVIDIA lightning model"
    },
    {
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "notes": "free on OpenRouter (:free): the NVIDIA ultra model"
    },
    {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "notes": "free (AI Studio), reasoning off"
    },
    {
      "provider": "gemini",
      "model": "gemini-3.6-flash",
      "notes": "free (AI Studio)"
    },
    {
      "provider": "gemini",
      "model": "gemini-3-flash-preview",
      "notes": "free (AI Studio)"
    },
    {
      "provider": "gemini",
      "model": "gemini-3.5-flash-lite",
      "notes": "free (AI Studio), larger daily quota; rejects reasoning_effort (retried without)"
    },
    {
      "provider": "groq",
      "model": "qwen/qwen3.8-27b",
      "notes": "free (Groq): 1000 req/day, 8k tokens/min, 1k output tokens/min -> MBPP only; reasoning off (\"low\" still thinks and fills the 500-token reply)",
      "extra_body": {
        "reasoning_effort": "none"
      }
    },
    {
      "provider": "groq",
      "model": "openai/gpt-oss-120b",
      "notes": "free (Groq): MBPP default (benchmarks/mbpp/v2: 26/29, 20 tasks solved at the first step, no retry); reasoning_effort=low; 8k tokens/min -> MBPP only"
    },
    {
      "provider": "cohere",
      "model": "north-mini-code-1.0",
      "notes": "free trial key: 1000 calls/month, 20/min"
    },
    {
      "provider": "cohere",
      "model": "command-a-03-2025",
      "notes": "free trial key: 1000 calls/month, 20/min"
    }
  ],
  "fallbacks": [
    {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "notes": "free"
    },
    {
      "provider": "gemini",
      "model": "gemini-3.5-flash-lite",
      "notes": "free"
    },
    {
      "provider": "groq",
      "model": "qwen/qwen3.8-27b",
      "notes": "free; small prompts only"
    }
  ],
  "benchmark_defaults": {
    "_doc": "Model used by agent_mbpp / agent_swebench when --model-name / --provider-url are not given: the first entry whose provider has a key in the environment (all free tiers).",
    "mbpp": [
      {
        "provider": "groq",
        "model": "openai/gpt-oss-120b"
      },
      {
        "provider": "groq",
        "model": "qwen/qwen3.8-27b"
      },
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
      },
      {
        "provider": "cohere",
        "model": "command-a-03-2025"
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3.5-lightning:free"
      }
    ],
    "swebench": [
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
      },
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3.5-lightning:free"
      },
      {
        "provider": "gemini",
        "model": "gemini-3.5-flash-lite"
      },
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3-ultra-550b-a55b"
      }
    ]
  },
  "fallback_enabled": true
}
